{
  "name": "hmpps-launchpad-home-ui",
  "version": "0.0.1",
  "description": "Hmpps Launchpad",
  "repository": "git@github.com:ministryofjustice/hmpps-launchpad-home-ui.git",
  "license": "MIT",
  "scripts": {
    "prepare": "hmpps-precommit-hooks-prepare",
    "watch-ts": "tsc -w",
    "build": "node esbuild/esbuild",
    "start": "node $NODE_OPTIONS dist/server.js | bunyan -o short",
    "start:dev": "node esbuild/esbuild --watch",
    "start-feature": "MOCK_AUTH=true node $NODE_DEBUG_OPTION --env-file=feature.env dist/server.js | bunyan -o short",
    "start-feature:dev": "node esbuild/esbuild --watch --env feature.env",
    "start-mock-app": "bash ./scripts/start-mock-app.sh",
    "lint": "eslint . --cache --max-warnings 0",
    "lint-fix": "eslint . --cache --max-warnings 0 --fix",
    "typecheck": "tsc && tsc -p integration_tests && tsc -p assets/js",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "security_audit": "npx audit-ci --config audit-ci.json",
    "int-test": "npx playwright test",
    "int-test-ui": "npx playwright test --ui",
    "int-test-init:ci": "npx playwright install",
    "int-test:mock": "BASE_URL=http://localhost:3000 REGRESSION=true npx playwright test",
    "clean": "rm -rf dist test_results",
    "rebuild": "npm run clean && npm run setup && npm run build",
    "setup": "npm ci"
  },
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "nodemonConfig": {
    "ignore": [
      ".circleci/*",
      "migrations/*",
      "node_modules/*",
      "test/*",
      "integration_tests/*"
    ],
    "delay": 2500,
    "ext": "js,json,html,njk"
  },
  "lint-staged": {
    "*.{ts,js,css}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ministryofjustice/eslint-config-hmpps": "^1.0.3",
    "@ministryofjustice/frontend": "^8.0.1",
    "@ministryofjustice/frontend-types": "2.0.1",
    "@ministryofjustice/hmpps-audit-client": "1.1.3",
    "@ministryofjustice/hmpps-azure-telemetry": "^1.0.2",
    "@ministryofjustice/hmpps-monitoring": "2.1.0",
    "@ministryofjustice/hmpps-prisoner-auth": "0.0.7",
    "@ministryofjustice/hmpps-prisoner-facing-components": "0.0.13",
    "@sentry/node": "^10.69.0",
    "@sentry/profiling-node": "^10.69.0",
    "agentkeepalive": "^4.6.0",
    "body-parser": "^2.3.0",
    "bunyan": "^1.8.15",
    "bunyan-format": "^0.2.1",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "connect-redis": "^9.0.0",
    "csrf-sync": "^4.2.1",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "express-prom-bundle": "^8.0.0",
    "express-session": "^1.19.0",
    "govuk-frontend": "^5.14.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "i18next": "^26.3.6",
    "i18next-fs-backend": "^2.6.7",
    "i18next-http-middleware": "^3.9.8",
    "jwt-decode": "^4.0.0",
    "nocache": "^4.0.0",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "prom-client": "^15.1.3",
    "redis": "^5.12.1",
    "superagent": "^10.3.0",
    "url-value-parser": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jgoz/esbuild-plugin-typecheck": "^4.0.4",
    "@ministryofjustice/eslint-config-hmpps": "^1.0.3",
    "@ministryofjustice/hmpps-npm-script-allowlist": "0.0.6",
    "@ministryofjustice/hmpps-precommit-hooks": "3.0.1",
    "@playwright/test": "1.62.1",
    "@tsconfig/node24": "24.0.4",
    "@types/bunyan": "^1.8.11",
    "@types/bunyan-format": "^0.2.9",
    "@types/compression": "^1.8.1",
    "@types/connect-flash": "0.0.40",
    "@types/cookie-session": "^2.0.49",
    "@types/express-session": "^1.19.0",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "24.13.3",
    "@types/nunjucks": "^3.2.6",
    "@types/passport": "^1.0.17",
    "@types/passport-openidconnect": "^0.1.3",
    "@types/superagent": "^8.1.11",
    "@types/supertest": "^7.2.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "audit-ci": "^7.1.0",
    "axe-core": "4.12.1",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.4",
    "cookie-session": "^2.1.1",
    "del": "8.0.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-manifest": "^1.0.5",
    "esbuild-sass-plugin": "^3.7.0",
    "jest": "^30.4.2",
    "jest-html-reporter": "^4.4.0",
    "jest-junit": "^17.0.0",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^17.4.1",
    "nock": "^14.0.17",
    "nodemon": "^3.1.14",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-jinja-template": "^2.2.0",
    "sass": "^1.102.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@opentelemetry/core": "2.10.0",
    "brace-expansion": "5.0.9",
    "dompurify": "3.4.13",
    "fast-xml-parser": "^5.10.1",
    "tmp": "^0.2.7",
    "form-data": "^4.0.6",
    "glob": "^13.0.6",
    "js-yaml": "^4.3.1",
    "diff": "^9.0.0"
  }
}
